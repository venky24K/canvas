# Google Cloud Platform (GCP) Configuration Template
# Populate these credentials to bind Bloom to a live production Google Cloud project.
# When running without keys, Bloom defaults to offline R&D evaluation mode.

VITE_GCP_PROJECT_ID=bloom-studio-prod
VITE_GCP_SOCKET_URL=http://localhost:4000

# Firebase Identity & Firestore Credentials
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=bloom-studio-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bloom-studio-prod
VITE_FIREBASE_STORAGE_BUCKET=bloom-studio-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1089204050201
VITE_FIREBASE_APP_ID=1:1089204050201:web:abcdef1234567890
